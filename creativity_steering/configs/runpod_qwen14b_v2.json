{
  "backend": "hf",
  "model_id": "Qwen/Qwen2.5-14B-Instruct",
  "device": "cuda",
  "dtype": "bf16",
  "seed": 0,
  "capture_position": "mean_response",
  "extra_capture_positions": ["last_response_token", "assistant_start"],
  "out_dir": "artifacts/qwen14b_run_v2",
  "generation": {
    "max_new_tokens": 256, "temperature": 0.9, "samples_per_prompt": 2, "seed": 0,
    "creative_sampling": {"temperature": 1.2, "top_p": 0.95, "top_k": 0, "min_p": 0.02, "repetition_penalty": 1.1},
    "neutral_sampling": {"temperature": 0.6, "top_p": 0.9, "top_k": 0, "min_p": 0.0, "repetition_penalty": 1.0},
    "unframed_sampling": {"temperature": 1.0, "top_p": 0.95, "top_k": 0, "min_p": 0.02, "repetition_penalty": 1.1}
  },
  "filtering": {
    "method": "score_split",
    "min_per_class": 50,
    "creative_score_min": 0.5,
    "neutral_score_max": 0.1,
    "enable_judge": true,
    "generator_family": "qwen",
    "stage1_floor_percentile": 0.0,
    "length_match": true,
    "length_match_tolerance": 0.3,
    "enable_reward": true,
    "use_reward_fallback": true,
    "scorer": "real"
  },
  "patching": {"alphas": [-4.0, -2.0, -1.0, 1.0, 2.0, 4.0], "all_layers_alpha": 0.1, "rescale": true, "eval_samples": 5, "sweep_evaluator": "two_stage", "judge_top_k": 5}
}
