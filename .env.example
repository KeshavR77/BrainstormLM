OPENAI_API_KEY=sk-...
TOGETHER_API_KEY=...
BRAINSTORMLM_DATA_DIR=./data
BRAINSTORMLM_CACHE_DIR=./data/cache
# Steering (plan-05): point at a derived `data/steering/<run_id>/` directory
# to enable --steered without passing --steering-path on every CLI call.
# BRAINSTORMLM_STEERING_DIR=./data/steering
# BRAINSTORMLM_STEERING_PATH=./data/steering/latest
# Production server (plan-06): bind host/port and persistence paths.
# BRAINSTORMLM_API_HOST=127.0.0.1
# BRAINSTORMLM_API_PORT=8000
# BRAINSTORMLM_FEEDBACK_HUMAN_PATH=./data/feedback_human.jsonl
# BRAINSTORMLM_AB_CONFIG_PATH=./data/ab_config.json
# BRAINSTORMLM_PROMOTED_ADAPTER_PATH=./data/adapters/promoted.json
# BRAINSTORMLM_SERVER_LOG_PATH=./data/logs/server.jsonl
